# Used by live `auto` / `generate --goal`.
# The CLI loads cwd/.env, then the repo-root .env, and never overrides
# variables already set in the shell. observe / run / explore / auto --decisions
# do not need a key. Do not commit this file after filling it in.
#
# Decision prefers Jev when TYPESAFE_API_KEY is set.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# Task plan before the browser opens. Also the decision when TYPESAFE_API_KEY is unset.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
TEXT_MODEL=gpt-4o-mini
# Optional. Used only when set. The CLI does not probe local proxy ports.
# HTTPS_PROXY=http://127.0.0.1:7897
#
# Optional Cloak browser. No default mirror is included.
# CLOAKBROWSER_DOWNLOAD_URL=https://example.com/cloakbrowser
# CLOAKBROWSER_SHA256=
# CLOAKBROWSER_GEOIP_URL=
# CLOAKBROWSER_GEOIP_SHA256=
# CLOAK_FINGERPRINT_SEED=
# CLOAK_USER_DATA_DIR=
